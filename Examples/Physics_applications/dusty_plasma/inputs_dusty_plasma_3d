# ####################################################################################################
# Example input file for dusty plasma simulation in WarpX
#
# This example demonstrates:
# - Three species: electrons, ions, and dust particles
# - Electron-dust and ion-dust collisions with dynamic charging
# - OML (Orbital Motion Limited) charging model
# - Momentum transfer (ion drag force)
#
# Physical scenario:
# - Dust grains (1 micron radius) immersed in argon plasma
# - Plasma parameters typical of low-pressure RF discharge
# ####################################################################################################

# Maximum number of time steps
max_step = 1000

# Grid configuration
amr.n_cell = 64 64 64
amr.max_level = 0

# Geometry
geometry.dims = 3
geometry.prob_lo = -1.0e-3  -1.0e-3  -1.0e-3   # 2 mm cube
geometry.prob_hi =  1.0e-3   1.0e-3   1.0e-3

# Boundary conditions (periodic)
boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic
boundary.particle_lo = periodic periodic periodic
boundary.particle_hi = periodic periodic periodic

# Time step (CFL = 0.99)
warpx.cfl = 0.99

# Algorithm
algo.particle_shape = 3  # Cubic shape factors
algo.charge_deposition = standard
algo.field_gathering = energy-conserving
algo.current_deposition = esirkepov

# Field solver: electrostatic
warpx.do_electrostatic = labframe
warpx.const_dt = 1.0e-10  # 0.1 ns time step

# ####################################################################################################
# Particle species
# ####################################################################################################

particles.species_names = electrons ions dust

# === Electrons ===
electrons.species_type = electron
electrons.injection_style = "NUniformPerCell"
electrons.num_particles_per_cell_each_dim = 4 4 4
electrons.profile = constant
electrons.density = 1.0e16  # 10^16 m^-3
electrons.momentum_distribution_type = "maxwell_boltzmann"
electrons.theta = 3.0  # 3 eV temperature

# === Ions (Argon) ===
ions.species_type = argon
ions.injection_style = "NUniformPerCell"
ions.num_particles_per_cell_each_dim = 4 4 4
ions.profile = constant
ions.density = 1.0e16  # 10^16 m^-3 (quasi-neutral)
ions.momentum_distribution_type = "maxwell_boltzmann"
ions.theta = 0.03  # 0.03 eV temperature (room temperature ions)

# === Dust particles ===
dust.species_type = dust
dust.injection_style = "NUniformPerCell"
dust.num_particles_per_cell_each_dim = 1 1 1  # Fewer dust particles
dust.profile = constant
dust.density = 1.0e10  # 10^10 m^-3 (much less than plasma density)
dust.momentum_distribution_type = "at_rest"
dust.initialize_self_fields = 0
dust.self_fields_required_precision = 1.e-11

# Dust particle properties
dust.mass = 8.38e-15  # kg, for 1 micron radius silica sphere
dust.charge = 0.0     # Initially neutral (will be charged dynamically)

# Add runtime attributes for dust particles
dust.addRealComp = dust_charge  # Charge in units of elementary charge
dust.addRealComp = dust_radius  # Particle radius in meters

# Initialize dust attributes
dust.attribute.dust_charge(x,y,z,t) = 0.0       # Initially neutral
dust.attribute.dust_radius(x,y,z,t) = 1.0e-6    # 1 micron radius

# ####################################################################################################
# Collisions
# ####################################################################################################

collisions.collision_names = electron_dust ion_dust

# === Electron-dust collisions ===
electron_dust.species = electrons dust
electron_dust.type = electrondustcollision
electron_dust.ndt = 1  # Perform every time step

# Dust parameters for electron collisions
electron_dust.dust_radius = 1.0e-6            # 1 micron
electron_dust.dust_density = 2000.0           # kg/m^3 (silica)
electron_dust.collection_efficiency = 1.0     # Full collection
electron_dust.enable_charging = 1
electron_dust.enable_momentum_transfer = 1

# === Ion-dust collisions ===
ion_dust.species = ions dust
ion_dust.type = iondustcollision
ion_dust.ndt = 1

# Dust parameters for ion collisions
ion_dust.dust_radius = 1.0e-6
ion_dust.dust_density = 2000.0
ion_dust.collection_efficiency = 0.5          # Reduced for ions (barrier effect)
ion_dust.enable_charging = 1
ion_dust.enable_momentum_transfer = 1
ion_dust.enable_coulomb_scattering = 1

# ####################################################################################################
# Diagnostics
# ####################################################################################################

# Full diagnostics
diagnostics.diags_names = diag1

diag1.intervals = 100
diag1.diag_type = Full
diag1.fields_to_plot = Ex Ey Ez Bx By Bz rho rho_electrons rho_ions rho_dust phi
diag1.electrons.variables = w ux uy uz
diag1.ions.variables = w ux uy uz
diag1.dust.variables = w ux uy uz dust_charge dust_radius

# Reduced diagnostics for monitoring
warpx.reduced_diags_names = field_energy particle_energy

field_energy.type = FieldEnergy
field_energy.intervals = 10

particle_energy.type = ParticleEnergy
particle_energy.intervals = 10

# ####################################################################################################
# Output
# ####################################################################################################

amr.plot_int = 100  # Plot every 100 steps
warpx.verbose = 1
